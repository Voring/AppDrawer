#!/bin/sh

APP_PATH="/Applications/AppDrawerURL.app"

refresh_icon_cache() {
	if command -v uicache >/dev/null 2>&1; then
		uicache -p "$APP_PATH" >/dev/null 2>&1 && return 0
	fi

	for JBROOT in /var/jb ""; do
		if [ -x "$JBROOT/usr/bin/uicache" ]; then
			"$JBROOT/usr/bin/uicache" -p "$JBROOT$APP_PATH" >/dev/null 2>&1 && return 0
		fi
	done

	return 1
}

refresh_icon_cache || true

exit 0
