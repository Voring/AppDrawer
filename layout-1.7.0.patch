-    if (scale < 2.0) {
-        scale = 3.0;
-    }
+    // 注意：+[UIScreen mainScreen] 带主线程断言，这里跑在 iconpreload 后台队列上，
+    // 直接访问会抛异常把 SpringBoard 打成安全模式，所以只读主线程写好的缓存值。
+    CGFloat scale = ADScreenScale;
